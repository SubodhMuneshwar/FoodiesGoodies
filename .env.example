# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=foodiesgoodies

# Edamam Recipe API
EDAMAM_APP_ID=your_edamam_app_id
EDAMAM_APP_KEY=your_edamam_app_key

# Email / Contact Configuration
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Google Gemini Server-Side AI Agent Configuration
# In production, set via environment variables. In development, prefer `dotnet user-secrets`.
GEMINI__APIKEY=your_gemini_api_key_here
GEMINI__MODEL=gemini-2.5-flash
GEMINI__BASEURL=https://generativelanguage.googleapis.com
GEMINI__TIMEOUTSECONDS=45
GEMINI__MAXAGENTITERATIONS=5
